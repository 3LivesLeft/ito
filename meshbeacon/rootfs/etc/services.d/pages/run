#!/bin/sh
# Nomad Network pages as their own user (ADR 0027, ADR 0018). It starts down; the core starts it only
# when pages are switched on, once Reticulum is up, stops it whenever Reticulum is not running, and
# restarts it with back-off. Output (its own and the Nomad Network daemon's) goes through a FIFO
# that root opens here, so the core can redact it before it reaches the log.
exec >/run/meshbeacon-io/pages/out 2>&1
umask 077
exec nice -n 10 /command/s6-setuidgid mb-nomad /usr/local/bin/python3 -I -u -m meshbeacon.pages \
    --data /data/nomadnet --pages /data/pages/public --socket /run/meshbeacon-pages/pages.sock
