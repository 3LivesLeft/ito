{
  "config": {
    "step": {
      "hassio_confirm": {
        "title": "ito",
        "description": "Add ito to show your Reticulum node's status, peers, traffic and resource use in Home Assistant. This is read-only: Home Assistant cannot control the node through it.\n\nDiscovered from the app **{app}** (`{slug}`). Only add it if you installed that app."
      }
    },
    "error": {
      "cannot_connect": "Could not reach the ito app. Check that it is running, then try again."
    },
    "abort": {
      "already_configured": "ito is already set up.",
      "discovery_only": "ito is added automatically. In the ito app's Configuration tab, switch on \"Show ito's status in Home Assistant\" and restart the app.",
      "invalid_discovery": "The details sent by the app could not be used, so nothing was set up. If this was the ito app, restart it; if this repeats, please report it."
    }
  },
